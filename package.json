{
	"name": "atem-state",
	"version": "1.3.0",
	"description": "Typescript Node.js library for comparing ATEM states",
	"type": "module",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sofie-Automation/sofie-atem-state"
	},
	"bugs": {
		"url": "https://github.com/Sofie-Automation/sofie-atem-state/issues"
	},
	"homepage": "https://github.com/Sofie-Automation/sofie-atem-state#readme",
	"author": {
		"name": "Balte de Wit",
		"email": "balte@superfly.tv",
		"url": "http://superfly.tv"
	},
	"contributors": [
		{
			"name": "Julian Waller",
			"email": "julian@superfly.tv"
		},
		{
			"name": "Johan Nyman",
			"email": "johan@superfly.tv"
		}
	],
	"scripts": {
		"prepare": "husky",
		"build": "rimraf dist && yarn build:main --force",
		"build:main": "tsc --build tsconfig.json",
		"lint:eslint": "eslint .",
		"lint:prettier": "prettier --check .",
		"lint:prettier:fix": "prettier --write .",
		"lint": "yarn lint:eslint && yarn lint:prettier",
		"lint:fix": "yarn lint:eslint --fix && yarn lint:prettier:fix",
		"unit": "vitest",
		"test": "yarn lint && yarn unit",
		"docs": "yarn docs:html",
		"docs:test": "yarn docs:html",
		"docs:html": "typedoc --tsconfig tsconfig.docs.json --entryPoints src/index.ts --excludePrivate --theme default --out docs",
		"docs:json": "typedoc --tsconfig tsconfig.docs.json --json docs/typedoc.json --entryPoints src/index.ts",
		"release": "sofie-version",
		"reset": "git clean -dfx && git reset --hard && yarn",
		"validate:dependencies": "yarn npm audit --environment production && run license-validate",
		"validate:dev-dependencies": "yarn npm audit --environment development",
		"license-validate": "sofie-licensecheck --allowPackages caniuse-lite@1.0.30001425"
	},
	"engines": {
		"node": "^22.16 || >= 24"
	},
	"files": [
		"/dist",
		"/CHANGELOG.md",
		"/README.md",
		"/LICENSE"
	],
	"devDependencies": {
		"@sofie-automation/code-standard-preset": "~4.0.4",
		"@types/node": "^22.20.5",
		"@types/object-path": "^0.11.4",
		"atem-connection": "3.10",
		"eslint": "^10.15.0",
		"fast-clone": "^1.5.13",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"object-path": "^0.11.8",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"keywords": [
		"typescript",
		"javascript",
		"open",
		"source"
	],
	"peerDependencies": {
		"atem-connection": "3.10"
	},
	"dependencies": {
		"deepmerge": "^4.3.1",
		"type-fest": "^5.10.0"
	},
	"prettier": "@sofie-automation/code-standard-preset/prettier.config.mjs",
	"lint-staged": {
		"*.{css,json,md,scss,yaml,yml}": [
			"prettier --check"
		],
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"eslint"
		]
	},
	"packageManager": "yarn@4.18.1",
	"resolutions": {
		"ajv": "^6.14.0"
	}
}
